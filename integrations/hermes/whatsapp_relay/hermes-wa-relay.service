[Unit]
Description=Family Assistant WhatsApp relay
After=hermes-gateway.service

[Service]
Type=simple
EnvironmentFile=%h/.config/family-assistant/whatsapp-relay.env
ExecStart=/usr/bin/python3 %h/.local/lib/family-assistant/whatsapp-relay.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
